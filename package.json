{
  "name": "x402-guard",
  "version": "0.0.0",
  "description": "A spending policy that holds across an agent's whole session — not one transaction at a time.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "demo": "tsx demo/live-payment.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@x402/express": "^2.18.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "tsx": "^4.23.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@x402/core": "^2.18.0",
    "@x402/evm": "^2.18.0",
    "@x402/fetch": "^2.18.0",
    "viem": "^2.55.2",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "examples",
    "LICENSE",
    "README.md",
    "DECISIONS.md"
  ]
}
